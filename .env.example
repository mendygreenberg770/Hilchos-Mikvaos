# Required for /api/ask (answering + auto-tagging)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: enables semantic (embedding) search. Without it, retrieval uses
# reference detection + FTS5 keyword search only — still very usable.
VOYAGE_API_KEY=

# Optional overrides
# ANSWER_MODEL=claude-sonnet-4-6      # everyday model (per spec)
# STRONG_MODEL=claude-opus-4-8        # for difficult sugyos ("strong" toggle in UI)
# TAGGING_MODEL=claude-haiku-4-5      # lightweight auto-tagging call
# VOYAGE_MODEL=voyage-3.5
# MIKVAOS_DB=data/mikvaos.db
